@page "/"
@inject LicenseDb Db

<PageTitle>Shops</PageTitle>

<div class="stats">
    <a class="stat" href="/?f=all"><b>@_all.Count</b><span>Shops</span></a>
    <a class="stat" href="/?f=paid"><b>@_all.Count(s => s.Plan != Plans.Basic && !s.Expired(_now))</b><span>Paid subscriptions</span></a>
    <a class="stat warn" href="/?f=soon"><b>@_all.Count(ExpiringSoon)</b><span>Ending in 14 days</span></a>
    <a class="stat danger" href="/?f=expired"><b>@_all.Count(s => s.Expired(_now))</b><span>Ended</span></a>
    <a class="stat" href="/?f=suspended"><b>@_all.Count(s => s.Suspended)</b><span>Suspended</span></a>
    <div class="stat"><b>@_all.Sum(s => s.Devices.Count(d => d.Active))</b><span>Active devices</span></div>
</div>

<form method="get" class="toolbar">
    <input name="q" value="@Q" placeholder="Search name, code, owner, phone" />
    <select name="f">
        @foreach (var (value, label) in Filters)
        {
            <option value="@value" selected="@(F == value)">@label</option>
        }
    </select>
    <button>Filter</button>
    <span class="spacer"></span>
    <a class="button primary" href="/shops/new">+ New shop</a>
</form>

<div class="table-wrap">
    <table>
        <thead>
            <tr><th>Shop</th><th>Code</th><th>Owner</th><th>Plan</th><th class="num">Devices</th><th class="num">Cashiers</th><th>Paid until</th><th>Last seen</th></tr>
        </thead>
        <tbody>
            @foreach (var s in _shown)
            {
                var active = s.Devices.Where(d => d.Active).ToList();
                <tr class="@(s.Suspended ? "muted-row" : "")">
                    <td><a href="/shops/@s.Id"><b>@s.Name</b></a> @if (s.Suspended) { <span class="badge danger">Suspended</span> }</td>
                    <td class="mono">@s.Code</td>
                    <td>@s.OwnerName<br /><span class="muted">@s.Phone</span></td>
                    <td>@s.Plan</td>
                    <td class="num">@active.Count / @s.MaxDevices</td>
                    <td class="num">@s.ActiveCashiers / @s.MaxCashiers</td>
                    <td class="@(s.Expired(_now) ? "danger-text" : ExpiringSoon(s) ? "warn-text" : "")">
                        @(MmTime.LastDay(s.ExpiresAt)?.ToString("dd-MM-yyyy") ?? "—")
                        @if (s.Expired(_now)) { <br /><span class="muted">now Basic</span> }
                    </td>
                    <td class="nowrap">@MmTime.Show(active.Count > 0 ? active.Max(d => d.LastSeenAt) : null)</td>
                </tr>
            }
            @if (_shown.Count == 0) { <tr><td colspan="8" class="empty">No shops yet. Add one with “+ New shop”.</td></tr> }
        </tbody>
    </table>
</div>

@code {
    [SupplyParameterFromQuery] string? Q { get; set; }
    [SupplyParameterFromQuery] string? F { get; set; }

    static readonly (string, string)[] Filters =
        [("all", "All shops"), ("paid", "Paid subscriptions"), ("soon", "Ending in 14 days"), ("expired", "Ended"), ("suspended", "Suspended")];

    readonly DateTime _now = DateTime.UtcNow;
    List<Shop> _all = [], _shown = [];

    bool ExpiringSoon(Shop s) => s.ExpiresAt is { } e && e > _now && e <= _now.AddDays(14);

    protected override async Task OnInitializedAsync()
    {
        _all = await Db.Shops.Include(s => s.Devices).AsNoTracking().OrderBy(s => s.Name).ToListAsync();
        var q = Q?.Trim() ?? "";
        _shown = _all.Where(s => q.Length == 0
                || s.Name.Contains(q, StringComparison.OrdinalIgnoreCase) || s.Code.Contains(q, StringComparison.OrdinalIgnoreCase)
                || s.OwnerName.Contains(q, StringComparison.OrdinalIgnoreCase) || s.Phone.Contains(q))
            .Where(s => F switch
            {
                "paid" => s.Plan != Plans.Basic && !s.Expired(_now),
                "soon" => ExpiringSoon(s),
                "expired" => s.Expired(_now),
                "suspended" => s.Suspended,
                _ => true,
            })
            .ToList();
    }
}
